{
  "name": "@paperclipai/erp-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Industrial ERP core: document control, revision management, and engineering data provenance.",
  "exports": {
    ".": "./src/index.ts",
    "./domain": "./src/domain/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "pnpm -w exec vitest run --root packages/erp-core --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@paperclipai/db": "workspace:*",
    "@paperclipai/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
